<UserControl
    x:Class="Openza.Tasks.Desktop.Views.CalendarDayView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ic="using:FluentIcons.Avalonia">
    <UserControl.Styles>
        <Style Selector="TextBlock.calendar-hour-label">
            <Setter Property="Foreground" Value="{DynamicResource OpenzaTextSecondaryBrush}" />
            <Setter Property="FontSize" Value="12" />
        </Style>
        <Style Selector="Border.calendar-hour-rule">
            <Setter Property="Background" Value="{DynamicResource OpenzaSeparatorBrush}" />
            <Setter Property="Opacity" Value="0.8" />
        </Style>
        <Style Selector="Border.calendar-half-hour-rule">
            <Setter Property="Background" Value="{DynamicResource OpenzaSeparatorBrush}" />
            <Setter Property="Opacity" Value="0.35" />
        </Style>
        <Style Selector="Border.calendar-day-block">
            <Setter Property="Background" Value="{DynamicResource OpenzaSurfaceAltBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource OpenzaBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{StaticResource OpenzaControlCornerRadius}" />
            <Setter Property="Padding" Value="6,3" />
        </Style>
        <Style Selector="Border.calendar-block-accent">
            <Setter Property="Background" Value="{DynamicResource OpenzaTextSecondaryBrush}" />
        </Style>
        <Style Selector="Border.calendar-now-rule">
            <Setter Property="Background" Value="{DynamicResource OpenzaAccentBrush}" />
        </Style>
        <Style Selector="TextBlock.calendar-block-title">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style Selector="TextBlock.calendar-block-time">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource OpenzaTextSecondaryBrush}" />
        </Style>
        <Style Selector="TextBlock.calendar-block-state">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource OpenzaTextSecondaryBrush}" />
        </Style>
        <Style Selector="Border.calendar-block-resize-handle">
            <Setter Property="Background" Value="{DynamicResource OpenzaAccentBrush}" />
            <Setter Property="Opacity" Value="0.55" />
        </Style>
        <Style Selector="Border.calendar-today-panel">
            <Setter Property="Background" Value="{DynamicResource OpenzaPaneBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource OpenzaSeparatorBrush}" />
        </Style>
        <Style Selector="Border.calendar-today-row">
            <Setter Property="BorderBrush" Value="{DynamicResource OpenzaSeparatorBrush}" />
            <Setter Property="BorderThickness" Value="0,0,0,1" />
        </Style>
    </UserControl.Styles>

    <Grid ColumnDefinitions="*,Auto">
        <Grid Grid.Column="0" RowDefinitions="Auto,*">
            <Border Grid.Row="0" Padding="0,8,8,12" BorderBrush="{DynamicResource OpenzaSeparatorBrush}" BorderThickness="0,0,0,1">
                <Grid RowDefinitions="Auto,Auto" RowSpacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <TextBlock FontSize="16" FontWeight="SemiBold" Text="{Binding SelectedDateText}" />
                        <Border Padding="8,3" Background="{DynamicResource OpenzaChipBackgroundBrush}" CornerRadius="5" IsVisible="{Binding IsSelectedDayToday}">
                            <TextBlock FontSize="12" Text="Today" />
                        </Border>
                    </StackPanel>
                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Spacing="6" VerticalAlignment="Center">
                        <TextBlock Margin="0,0,8,0" Padding="8,4" Background="{DynamicResource OpenzaChipBackgroundBrush}" FontSize="12" Text="{Binding NowText}" IsVisible="{Binding IsSelectedDayToday}" />
                        <Button x:Name="CalendarAddBlockButton" AutomationProperties.Name="Add a time block" Content="Add block" Click="OnAddBlockClicked" />
                        <Button AutomationProperties.Name="Go to today" Content="Today" Click="OnGoToTodayClicked" />
                        <Button Width="36" Padding="0" AutomationProperties.Name="Previous day" Click="OnPreviousDayClicked">
                            <ic:FluentIcon Icon="ChevronLeft" FontSize="18" />
                        </Button>
                        <Button Width="36" Padding="0" AutomationProperties.Name="Next day" Click="OnNextDayClicked">
                            <ic:FluentIcon Icon="ChevronRight" FontSize="18" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <ScrollViewer x:Name="TimelineScrollViewer" Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                <Grid Height="{Binding TimelineHeight}" ColumnDefinitions="56,*">
                    <Canvas x:Name="HourLabelsCanvas" Grid.Column="0" Width="56" Height="{Binding TimelineHeight}" IsHitTestVisible="False" />
                    <Canvas x:Name="TimelineCanvas" Grid.Column="1" Height="{Binding TimelineHeight}" Background="Transparent" SizeChanged="OnTimelineSizeChanged" PointerPressed="OnTimelinePointerPressed" />
                </Grid>
            </ScrollViewer>
        </Grid>

        <Border Grid.Column="1" Width="340" Classes="calendar-today-panel" BorderThickness="1,0,0,0" IsVisible="{Binding IsTodayPanelOpen}">
            <Grid RowDefinitions="Auto,Auto,*">
                <Border Padding="20,18" BorderBrush="{DynamicResource OpenzaSeparatorBrush}" BorderThickness="0,0,0,1">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <StackPanel Spacing="4">
                            <TextBlock FontSize="20" FontWeight="SemiBold" Text="Today" />
                            <TextBlock FontSize="12" Foreground="{DynamicResource OpenzaTextSecondaryBrush}" Text="{Binding TodaySummaryText}" />
                        </StackPanel>
                        <Button Grid.Column="1" Width="34" Height="34" Padding="0" AutomationProperties.Name="Close Today panel" Click="OnCloseTodayPanelClicked">
                            <ic:FluentIcon Icon="Dismiss" FontSize="18" />
                        </Button>
                    </Grid>
                </Border>
                <TextBox Grid.Row="1" Margin="16,16,16,8" Height="38" AutomationProperties.Name="Search Today tasks" PlaceholderText="Search this list" Text="{Binding TodaySearchText, Mode=TwoWay}" />
                <Grid Grid.Row="2" Margin="16,0,16,12">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding FilteredTodayTasks}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Classes="calendar-today-row" MinHeight="78" Padding="8,12">
                                        <Grid ColumnDefinitions="28,*" ColumnSpacing="8">
                                            <CheckBox VerticalAlignment="Center" AutomationProperties.Name="{Binding CalendarPanelCompletionName}" IsChecked="{Binding IsCompleted, Mode=OneWay}" Click="OnTodayTaskCompletionClicked" />
                                            <Button Grid.Column="1" MinHeight="56" Padding="4,2" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center" AutomationProperties.Name="{Binding CalendarPanelAccessibleName}" Click="OnTodayTaskClicked">
                                                <StackPanel Spacing="5">
                                                    <TextBlock FontSize="14" FontWeight="SemiBold" MaxLines="1" Text="{Binding Title}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                                    <TextBlock FontSize="12" Foreground="{DynamicResource OpenzaTextSecondaryBrush}" Text="{Binding CalendarPanelMetadataText}" TextWrapping="Wrap" />
                                                </StackPanel>
                                            </Button>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource OpenzaTextSecondaryBrush}" Text="{Binding TodayEmptyText}" IsVisible="{Binding HasNoTodayTasks}" />
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
