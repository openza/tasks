<Application
    x:Class="Openza.Tasks.Desktop.App"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedThemeVariant="Default">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Openza.Tasks.Desktop/Styles/DesignTokens.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
    <Application.Styles>
        <FluentTheme DensityStyle="Normal" />
        <Style Selector="Button.accent">
            <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />
        </Style>
        <Style Selector="Button.primary-command">
            <Setter Property="Background" Value="{DynamicResource OpenzaAccentBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource OpenzaOnAccentBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource OpenzaAccentBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource OpenzaControlCornerRadius}" />
        </Style>
        <Style Selector="Button.primary-command:pointerover">
            <Setter Property="Background" Value="{DynamicResource OpenzaAccentHoverBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource OpenzaAccentHoverBrush}" />
        </Style>
        <Style Selector="Button.primary-command:pressed">
            <Setter Property="Background" Value="{DynamicResource OpenzaAccentPressedBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource OpenzaAccentPressedBrush}" />
        </Style>
        <Style Selector="Button.nav-command">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="{DynamicResource OpenzaControlCornerRadius}" />
        </Style>
        <Style Selector="Grid.navigation-compact TextBlock.nav-label">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="Grid.navigation-compact Border.nav-badge">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="Grid.navigation-compact ComboBox.space-picker">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="Button.compact-only">
            <Setter Property="IsVisible" Value="False" />
        </Style>
        <Style Selector="Grid.navigation-compact Button.compact-only">
            <Setter Property="IsVisible" Value="True" />
        </Style>
        <Style Selector="Button.quiet">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Button.command">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style Selector="Button.list-command">
            <Setter Property="Background" Value="{DynamicResource ControlFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ControlStrokeColorDefaultBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.section-title">
            <Setter Property="FontSize" Value="{DynamicResource OpenzaSectionTitleSize}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource OpenzaTextPrimaryBrush}" />
        </Style>
        <Style Selector="TextBlock.page-title">
            <Setter Property="FontSize" Value="{DynamicResource OpenzaPageTitleSize}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource OpenzaTextPrimaryBrush}" />
        </Style>
        <Style Selector="TextBlock.metadata">
            <Setter Property="FontSize" Value="{DynamicResource OpenzaMetadataSize}" />
            <Setter Property="Foreground" Value="{DynamicResource OpenzaTextSecondaryBrush}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource OpenzaElevatedSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource OpenzaBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource OpenzaCardCornerRadius}" />
        </Style>
        <Style Selector="Border.settings-card">
            <Setter Property="Background" Value="{DynamicResource OpenzaElevatedSurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource OpenzaBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="{DynamicResource OpenzaCardCornerRadius}" />
        </Style>
        <Style Selector="StackPanel.field-row">
            <Setter Property="Spacing" Value="4" />
        </Style>
        <Style Selector="TextBlock.field-label">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style Selector="Border.task-row StackPanel.quick-actions">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>
        <Style Selector="Border.task-row:pointerover StackPanel.quick-actions">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="IsHitTestVisible" Value="True" />
        </Style>
        <Style Selector="Border.task-row:focus-within StackPanel.quick-actions">
            <Setter Property="Opacity" Value="1" />
            <Setter Property="IsHitTestVisible" Value="True" />
        </Style>
        <Style Selector="Border.task-row:pointerover Border.priority-chip">
            <Setter Property="Opacity" Value="0" />
        </Style>
        <Style Selector="Border.task-row:focus-within Border.priority-chip">
            <Setter Property="Opacity" Value="0" />
        </Style>
        <Style Selector="ListBox.hide-row-actions StackPanel.quick-actions">
            <Setter Property="IsVisible" Value="False" />
            <Setter Property="IsEnabled" Value="False" />
        </Style>
        <Style Selector="ListBox.hide-row-actions Border.task-row:pointerover Border.priority-chip">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="ListBox.hide-row-actions Border.task-row:focus-within Border.priority-chip">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="Button.row-action">
            <Setter Property="Width" Value="32" />
            <Setter Property="MinWidth" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
    </Application.Styles>
</Application>
