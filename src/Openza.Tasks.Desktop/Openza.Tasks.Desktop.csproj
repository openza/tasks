<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <TargetFramework Condition="'$(OpenzaWindowsContinuity)' == 'Dev'">net10.0-windows10.0.19041.0</TargetFramework>
    <EnableWindowsTargeting Condition="'$(OpenzaWindowsContinuity)' == 'Dev'">true</EnableWindowsTargeting>
    <DefineConstants Condition="'$(OpenzaWindowsContinuity)' == 'Dev'">$(DefineConstants);OPENZA_WINDOWS_CONTINUITY_DEV</DefineConstants>
    <WindowsAppSDKSelfContained Condition="'$(OpenzaWindowsContinuity)' == 'Dev'">true</WindowsAppSDKSelfContained>
    <RuntimeIdentifier Condition="'$(OpenzaWindowsContinuity)' == 'Dev'">win-x64</RuntimeIdentifier>
    <PlatformTarget Condition="'$(OpenzaWindowsContinuity)' == 'Dev'">x64</PlatformTarget>
    <EnableMsixTooling Condition="'$(OpenzaWindowsContinuity)' == 'Dev'">false</EnableMsixTooling>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <RootNamespace>Openza.Tasks.Desktop</RootNamespace>
    <AssemblyName>Openza.Tasks.Desktop</AssemblyName>
  </PropertyGroup>

  <Import Project="..\..\packaging\channels\$(OpenzaPackagingProfile).props"
          Condition="('$(OpenzaPackagingProfile)' == 'Production' or '$(OpenzaPackagingProfile)' == 'Preview') and '$(MSBuildProjectFile)' == 'Openza.Tasks.Desktop.Package.csproj'" />

  <PropertyGroup>
    <OpenzaChannel Condition="'$(OpenzaChannel)' == ''">Dev</OpenzaChannel>
  </PropertyGroup>

  <PropertyGroup>
    <MicrosoftGraphClientId Condition="'$(MicrosoftGraphClientId)' == '' and '$(OpenzaChannel)' == 'Dev'">fbf30ec3-0911-4338-8d2a-1f55d003f77c</MicrosoftGraphClientId>
    <MicrosoftGraphClientId Condition="'$(MicrosoftGraphClientId)' == ''">1ee7c73f-5894-4167-8a99-3ee8b2666b8c</MicrosoftGraphClientId>
    <MicrosoftGraphTenantId Condition="'$(MicrosoftGraphTenantId)' == ''">common</MicrosoftGraphTenantId>
    <GitHubClientId Condition="'$(GitHubClientId)' == ''">Ov23liA6rFJwuT18Zv3m</GitHubClientId>
    <CloudflareOAuthClientId Condition="'$(CloudflareOAuthClientId)' == ''">ab8248060e7dc03bb9ccf7f71c179e45</CloudflareOAuthClientId>
    <CloudflareOAuthScopes Condition="'$(CloudflareOAuthScopes)' == ''">account-settings.read d1.write workers-scripts.write</CloudflareOAuthScopes>
    <CloudflareOAuthRedirectUri Condition="'$(CloudflareOAuthRedirectUri)' == ''">http://127.0.0.1:48192/cloudflare/callback</CloudflareOAuthRedirectUri>
  </PropertyGroup>
  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute"><_Parameter1>MicrosoftGraphClientId</_Parameter1><_Parameter2>$(MicrosoftGraphClientId)</_Parameter2></AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute"><_Parameter1>MicrosoftGraphTenantId</_Parameter1><_Parameter2>$(MicrosoftGraphTenantId)</_Parameter2></AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute"><_Parameter1>GitHubClientId</_Parameter1><_Parameter2>$(GitHubClientId)</_Parameter2></AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute"><_Parameter1>CloudflareOAuthClientId</_Parameter1><_Parameter2>$(CloudflareOAuthClientId)</_Parameter2></AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute"><_Parameter1>CloudflareOAuthScopes</_Parameter1><_Parameter2>$(CloudflareOAuthScopes)</_Parameter2></AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute"><_Parameter1>CloudflareOAuthRedirectUri</_Parameter1><_Parameter2>$(CloudflareOAuthRedirectUri)</_Parameter2></AssemblyAttribute>
  </ItemGroup>
  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>OpenzaChannel</_Parameter1>
      <_Parameter2>$(OpenzaChannel)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>OpenzaPackagingProfile</_Parameter1>
      <_Parameter2>$(OpenzaPackagingProfile)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="FluentIcons.Avalonia" Version="2.1.345" />
    <PackageReference Include="Microsoft.Identity.Client" Version="4.84.0" />
  </ItemGroup>

  <ItemGroup Condition="'$(OpenzaWindowsContinuity)' == 'Dev'">
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.0.1" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.7" />
  </ItemGroup>

  <Target Name="ValidateWindowsContinuityGate" BeforeTargets="PrepareForBuild"
          Condition="'$(OpenzaWindowsContinuity)' != ''">
    <Error Condition="'$(OpenzaWindowsContinuity)' != 'Dev' or '$(OpenzaChannel)' != 'Dev'"
           Text="Windows continuity is restricted to the explicit Dev build gate; Preview and Production remain disabled." />
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\Openza.Tasks.Application\Openza.Tasks.Application.csproj" />
    <ProjectReference Include="..\Openza.Tasks.Core\Openza.Tasks.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="..\..\assets\icons\icon-256.png" Link="Assets\openza-tasks.png" />
  </ItemGroup>

  <ItemGroup Condition="'$(PersonalCloudArtifactDirectory)' != '' and Exists('$(PersonalCloudArtifactDirectory)/artifact-manifest.json')">
    <Content Include="$(PersonalCloudArtifactDirectory)/**/*" Link="PersonalCloudArtifact/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <Import Project="..\..\packaging\channels\Openza.Channel.targets" />
</Project>
