<Window
    x:Class="Openza.Tasks.Desktop.Dialogs.ConfirmWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="440"
    SizeToContent="Height"
    CanResize="False"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner">
    <Grid Margin="24" RowDefinitions="Auto,Auto,Auto" RowSpacing="14">
        <TextBlock x:Name="TitleText" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock x:Name="MessageText" Grid.Row="1" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" />
        <StackPanel Grid.Row="2" HorizontalAlignment="Right" Orientation="Horizontal" Spacing="8">
            <Button x:Name="CancelButton" Click="OnCancelClicked" Content="Cancel" />
            <Button x:Name="ConfirmButton" Classes="accent" Click="OnConfirmClicked" Content="Delete" />
        </StackPanel>
    </Grid>
</Window>
