<Window
    x:Class="Openza.Tasks.Desktop.Dialogs.CalendarBlockPickerWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="520"
    Height="640"
    MinWidth="460"
    MinHeight="520"
    CanResize="True"
    ShowInTaskbar="False"
    Title="Add a time block"
    WindowStartupLocation="CenterOwner">
    <Window.Styles>
        <Style Selector="Button.dialogAction">
            <Setter Property="MinWidth" Value="112" />
        </Style>
    </Window.Styles>
    <Grid Margin="24" RowDefinitions="Auto,*,Auto" RowSpacing="18">
        <StackPanel Spacing="6">
            <TextBlock Classes="dialog-title" IsVisible="{Binding IsTaskSelectionVisible}" Text="Add a time block" />
            <TextBlock Classes="dialog-title" IsVisible="{Binding IsEditing}" Text="Edit a time block" />
        </StackPanel>

        <Grid Grid.Row="1" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="8">
            <TextBlock FontWeight="SemiBold" Text="Length" />
            <Grid Grid.Row="1" ColumnDefinitions="Auto,*" ColumnSpacing="10">
                <NumericUpDown x:Name="DurationPicker" Width="120" AutomationProperties.Name="Block length in minutes" Minimum="1" Maximum="2147483647" Increment="15" Value="{Binding DurationMinutes, Mode=TwoWay}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Foreground="{DynamicResource OpenzaTextSecondaryBrush}" Text="minutes · ends" />
                    <TextBlock Foreground="{DynamicResource OpenzaTextSecondaryBrush}" Text="{Binding EndText}" />
                </StackPanel>
            </Grid>
            <Grid Grid.Row="2" ColumnDefinitions="Auto,*" ColumnSpacing="10">
                <TextBlock VerticalAlignment="Center" Text="Start" />
                <StackPanel Grid.Column="1" Spacing="4">
                    <TextBox AutomationProperties.Name="Start time" PlaceholderText="HH:mm" Text="{Binding StartTimeText, Mode=TwoWay}" />
                    <TextBlock FontSize="12" Foreground="{DynamicResource OpenzaTextSecondaryBrush}" Text="{Binding StartDateText}" />
                    <TextBlock IsVisible="{Binding HasInvalidStartTime}" FontSize="12" Foreground="{DynamicResource OpenzaDangerBrush}" Text="Enter a valid local time in 24-hour HH:mm format." />
                </StackPanel>
            </Grid>
            <Grid Grid.Row="3">
                <Grid x:Name="TaskPickerGrid" IsVisible="{Binding IsTaskSelectionVisible}" RowDefinitions="Auto,*" RowSpacing="8">
                    <TextBox x:Name="SearchBox" AutomationProperties.Name="Search open tasks" PlaceholderText="Search open tasks" Text="{Binding SearchText, Mode=TwoWay}" />
                    <Grid Grid.Row="1">
                        <ListBox x:Name="TaskList" AutomationProperties.Name="Open tasks" ItemsSource="{Binding FilteredTasks}" SelectedItem="{Binding SelectedTask, Mode=TwoWay}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="4,6" Spacing="3">
                                        <TextBlock FontWeight="SemiBold" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock FontSize="12" Foreground="{DynamicResource OpenzaTextSecondaryBrush}" Text="{Binding Status}" />
                                            <TextBlock FontSize="12" Foreground="{DynamicResource OpenzaTextSecondaryBrush}" Text="{Binding ProjectName}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource OpenzaTextSecondaryBrush}" IsVisible="{Binding HasNoTasks}" Text="No matching open tasks" />
                    </Grid>
                </Grid>
                <StackPanel IsVisible="{Binding IsEditing}" Spacing="4">
                    <TextBlock FontWeight="SemiBold" Text="Task" />
                    <TextBlock Text="{Binding SelectedTask.Title}" />
                </StackPanel>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Padding="0,16,0,0" BorderBrush="{DynamicResource OpenzaSeparatorBrush}" BorderThickness="0,1,0,0">
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="10">
                <Button Classes="dialogAction" Content="Cancel" IsCancel="True" Click="OnCancelClicked" />
                <Button Classes="accent dialogAction" Content="Add block" IsVisible="{Binding IsTaskSelectionVisible}" IsDefault="True" IsEnabled="{Binding CanSchedule}" Click="OnAddBlockClicked" />
                <Button Classes="accent dialogAction" Content="Save time" IsVisible="{Binding IsEditing}" IsDefault="True" IsEnabled="{Binding CanSchedule}" Click="OnAddBlockClicked" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
