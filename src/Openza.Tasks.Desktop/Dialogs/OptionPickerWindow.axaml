<Window
    x:Class="Openza.Tasks.Desktop.Dialogs.OptionPickerWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="480"
    Height="520"
    MinWidth="400"
    MinHeight="360"
    CanResize="True"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    Opened="OnOpened">
    <Grid RowDefinitions="Auto,*,Auto">
        <StackPanel Margin="24,22,24,14" Spacing="4">
            <TextBlock x:Name="TitleText" Classes="dialog-title" />
            <TextBlock x:Name="DescriptionText" Foreground="{DynamicResource OpenzaTextSecondaryBrush}" TextWrapping="Wrap" />
        </StackPanel>
        <ListBox
            x:Name="OptionsList"
            Grid.Row="1"
            Margin="18,0"
            AutomationProperties.Name="Options"
            DoubleTapped="OnOptionDoubleTapped">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="8,7" Spacing="3">
                        <TextBlock FontWeight="SemiBold" Text="{Binding Title}" TextWrapping="Wrap" />
                        <TextBlock FontSize="12" Foreground="{DynamicResource OpenzaTextSecondaryBrush}" Text="{Binding Subtitle}" TextWrapping="Wrap" IsVisible="{Binding Subtitle, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <Border Grid.Row="2" Padding="24,14" BorderBrush="{DynamicResource OpenzaSeparatorBrush}" BorderThickness="0,1,0,0">
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" Spacing="10">
                <Button MinWidth="100" Click="OnCancelClicked" Content="Cancel" IsCancel="True" />
                <Button MinWidth="100" Classes="accent" Click="OnChooseClicked" Content="Choose" IsDefault="True" IsEnabled="{Binding #OptionsList.SelectedItem, Converter={x:Static ObjectConverters.IsNotNull}}" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
