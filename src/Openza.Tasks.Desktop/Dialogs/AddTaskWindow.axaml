<Window
    x:Class="Openza.Tasks.Desktop.Dialogs.AddTaskWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Width="560"
    SizeToContent="Height"
    CanResize="False"
    ShowInTaskbar="False"
    Title="Add task"
    WindowStartupLocation="CenterOwner"
    Opened="OnOpened">
    <Grid RowDefinitions="*,Auto">
        <StackPanel Margin="26,24,26,28" Spacing="14">
            <TextBlock FontSize="24" FontWeight="SemiBold" Text="Add task" />
            <StackPanel Spacing="5"><TextBlock Text="Task"/><TextBox x:Name="TitleBox" PlaceholderText="What needs doing?"/></StackPanel>
            <StackPanel Spacing="5"><TextBlock Text="Notes"/><TextBox x:Name="NotesBox" MinHeight="90" AcceptsReturn="True" VerticalContentAlignment="Top" TextWrapping="Wrap"/></StackPanel>
            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="12">
                <StackPanel Spacing="5"><TextBlock Text="Project"/><ComboBox x:Name="ProjectPicker" ItemsSource="{Binding ProjectOptions}"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Title}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox></StackPanel>
                <StackPanel Grid.Column="1" Spacing="5"><TextBlock Text="Status"/><ComboBox x:Name="StatusPicker"><ComboBoxItem Content="Inbox"/><ComboBoxItem Content="Next"/><ComboBoxItem Content="Waiting"/><ComboBoxItem Content="Someday"/></ComboBox></StackPanel>
                <StackPanel Grid.Row="1" Spacing="5"><TextBlock Text="Priority"/><ComboBox x:Name="PriorityPicker"><ComboBoxItem Content="Highest"/><ComboBoxItem Content="High"/><ComboBoxItem Content="Normal"/><ComboBoxItem Content="Low"/></ComboBox></StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="1" Spacing="5"><TextBlock Text="Date"/><DatePicker x:Name="DatePicker"/></StackPanel>
            </Grid>
            <StackPanel Spacing="5">
                <TextBlock Text="Labels" />
                <AutoCompleteBox
                    x:Name="LabelsBox"
                    ItemsSource="{Binding LabelSuggestions}"
                    MaxDropDownHeight="240"
                    MinimumPrefixLength="1"
                    PlaceholderText="Add label" />
                <TextBlock
                    FontSize="12"
                    Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                    Text="Separate multiple labels with commas." />
            </StackPanel>
        </StackPanel>
        <Border Grid.Row="1" Padding="26,16" Background="{DynamicResource LayerFillColorDefaultBrush}" BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}" BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10"><Button Classes="accent" Click="OnCreateClicked" Content="Create"/><Button Grid.Column="1" Click="OnCreateAndOpenClicked" Content="Create and open"/><Button Grid.Column="2" Click="OnCancelClicked" Content="Cancel"/></Grid>
        </Border>
    </Grid>
</Window>
