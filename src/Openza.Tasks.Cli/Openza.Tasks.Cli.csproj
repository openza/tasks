<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Openza.Tasks.Cli</RootNamespace>
    <AssemblyName>openza</AssemblyName>
  </PropertyGroup>

  <Import Project="..\..\packaging\channels\$(OpenzaPackagingProfile).props"
          Condition="('$(OpenzaPackagingProfile)' == 'Production' or '$(OpenzaPackagingProfile)' == 'Preview') and '$(MSBuildProjectFile)' == 'Openza.Tasks.Cli.Package.csproj'" />

  <PropertyGroup>
    <OpenzaChannel Condition="'$(OpenzaChannel)' == ''">Dev</OpenzaChannel>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>OpenzaChannel</_Parameter1>
      <_Parameter2>$(OpenzaChannel)</_Parameter2>
    </AssemblyAttribute>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>OpenzaPackagingProfile</_Parameter1>
      <_Parameter2>$(OpenzaPackagingProfile)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" Version="2.0.11" />
    <ProjectReference Include="..\Openza.Tasks.Application\Openza.Tasks.Application.csproj" />
    <ProjectReference Include="..\Openza.Tasks.Core\Openza.Tasks.Core.csproj" />
  </ItemGroup>

  <Import Project="..\..\packaging\channels\Openza.Channel.targets" />
</Project>
